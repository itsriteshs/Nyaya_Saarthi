# Leave NYAYA_DATABASE_URL unset to use backend/nyaya.db regardless of cwd.
# NYAYA_DATABASE_URL=sqlite:////absolute/path/to/nyaya.db
NYAYA_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NYAYA_LLM_PROVIDER=ollama
NYAYA_OLLAMA_URL=http://127.0.0.1:11434
NYAYA_LLM_DEFAULT_MODEL=llama3.2-3b
NYAYA_LLM_TIMEOUT=90
NYAYA_LLM_TEMPERATURE=0
NYAYA_LLM_MAX_TOKENS=700
NYAYA_LLM_CONTEXT_CHARS=12000
# Intake uses the same two-model registry, independently of Guidance selection.
NYAYA_INTAKE_SLM_ENABLED=true
NYAYA_INTAKE_MODEL=llama3.2-3b
# Clamped to 1-90s; unavailable/invalid output falls back without failing intake.
NYAYA_INTAKE_TIMEOUT=60
